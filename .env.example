# Copy to .env and fill in. Never commit .env.

NFT_NAME="My PFP"
NFT_SYMBOL="PFP"
# Folder with 1.json ... 555.json. Can be set later with setBaseURI.
BASE_URI="ipfs://REPLACE_WITH_CID/"
# How many of the 555 the free mint can hand out. The rest stay unminted for swaps.
PUBLIC_MINT_CAP=444
MAX_PER_WALLET=1
# Optional: a multisig or other wallet to own the contract. Defaults to the deployer.
# OWNER=0x...
